#!/usr/bin/env gnuplot

load 'style.gpi'

set terminal pdfcairo
set output "latency-p99.pdf"

set grid ytics
set tics nomirror
set xlabel "Queries per second (QPS)"
set ylabel "Latency (s)"
set key bottom right

set logscale y

plot '../p99.dat' \
        using 1:($2) with linespoints linestyle 3 linewidth 4 pointtype 3 title 'mTLS Istio', \
     '' using 1:($3) with linespoints linestyle 4 linewidth 4 pointtype 4 title 'Mazu NIChaRes', \
     '' using 1:($4) with linespoints linestyle 5 linewidth 4 pointtype 5 title 'Mazu TokRev', \
     '' using 1:($5) with linespoints linestyle 6 linewidth 4 pointtype 6 title 'Mazu AudUpd', \
     '' using 1:($6) with linespoints linestyle 7 linewidth 4 pointtype 7 title 'Mazu AttUpd'

