load "../style.gpi"

set terminal pdfcairo enhanced color
set output "memory_comparison.pdf"

set style data histogram
set style histogram clustered gap 1
set style fill solid 0.8 border -1

set boxwidth 0.9

set ylabel "Memory Usage (MB)" font "Helvetica, 16"
set xlabel "Component" font "Helvetica, 16"
set title "Memory Usage: Istio vs Mazu\n(50 RPS, 4min, avg of 10 runs)" font "Helvetica, 16"

set key top left font "Helvetica, 12"
set xtics font "Helvetica, 12" rotate by 25 right
set ytics font "Helvetica, 12"

set grid ytics lt 0 lw 0.5

set logscale y

plot "plot_memory.dat" using 2:xtic(1) title "Istio" ls 1, \
     '' using 4 title "Mazu" ls 2
