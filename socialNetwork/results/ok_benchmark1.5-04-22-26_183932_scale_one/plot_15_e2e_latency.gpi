load "style.gpi"

set terminal pdfcairo enhanced color
set output "plot_15_e2e_latency.pdf"

set xlabel "Queries per second (QPS)"
set ylabel "Latency (ms)"
# set key top left maxrows 3
set key bottom right maxrows 3
set logscale y

set grid ytics
set tics nomirror

plot \
    keyentry with linespoints linestyle 1 linewidth 4 pointtype 5 pointsize 0.5 title "Istio", \
    keyentry with linespoints linestyle 2 linewidth 4 pointtype 5 pointsize 0.5 title "Mazu", \
    keyentry title " ", \
    keyentry with linespoints linecolor rgb "black" linewidth 4 pointtype 5  pointsize 0.5 dashtype 1 title "p50", \
    keyentry with linespoints linecolor rgb "black" linewidth 4 pointtype 7  pointsize 0.5 dashtype 2 title "p90", \
    keyentry with linespoints linecolor rgb "black" linewidth 4 pointtype 13 pointsize 0.5 dashtype 3 title "p99", \
    'istio/latency.dat'     using 1:2 notitle with linespoints linestyle 1 linewidth 4 pointtype 5  pointsize 0.5 dashtype 1, \
    'istio/latency.dat'     using 1:3 notitle with linespoints linestyle 1 linewidth 4 pointtype 7  pointsize 0.5 dashtype 2, \
    'istio/latency.dat'     using 1:4 notitle with linespoints linestyle 1 linewidth 4 pointtype 13 pointsize 0.5 dashtype 3, \
    'st5-AttUpd/latency.dat' using 1:2 notitle with linespoints linestyle 2 linewidth 4 pointtype 5  pointsize 0.5 dashtype 1, \
    'st5-AttUpd/latency.dat' using 1:3 notitle with linespoints linestyle 2 linewidth 4 pointtype 7  pointsize 0.5 dashtype 2, \
    'st5-AttUpd/latency.dat' using 1:4 notitle with linespoints linestyle 2 linewidth 4 pointtype 13 pointsize 0.5 dashtype 3
