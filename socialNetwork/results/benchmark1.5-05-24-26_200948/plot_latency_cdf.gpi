set terminal pdfcairo size 7,4.5 font "Helvetica,11"
set output "latency_cdf.pdf"

set title "Latency CDF at 400 RPS  (run 05-24 20:09:48)"
set xlabel "Percentile"
set ylabel "Latency (ms, log scale)"
set logscale y
set yrange [5:50000]
set grid xtics ytics ls 0 lc rgb "#cccccc"
set key top left

# Pull the y-axis past the bimodal cliff to make it obvious
set xrange [0:1]
set xtics ("0" 0, "p10" 0.1, "p25" 0.25, "p50" 0.5, "p75" 0.75, "p90" 0.9, "p95" 0.95, "p99" 0.99, "1" 1.0)

# Annotate the Mazu cliff between p30 and p40
set label 1 "Mazu cliff:\np30=33ms → p40=1816ms" at 0.36,800 left font ",10" textcolor rgb "#d62728"
set arrow 1 from 0.36,500 to 0.395,1900 lw 1.5 lc rgb "#d62728" filled

plot \
  "latency_cdf.dat" using 1:2 with lines lw 2.5 lc rgb "#1f77b4" title "Istio", \
  "latency_cdf.dat" using 1:3 with lines lw 2.5 lc rgb "#d62728" title "Mazu (st5-AttUpd)"
