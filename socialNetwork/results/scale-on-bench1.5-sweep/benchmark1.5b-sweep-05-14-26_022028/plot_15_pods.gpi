load "style.gpi"

set terminal pdfcairo enhanced color
set output "plot_15_pods.pdf"

set xlabel "Queries per second (QPS)"
set ylabel "Total active pods"
set key top left maxrows 3

set grid ytics
set tics nomirror

plot \
    keyentry with linespoints linestyle 1 linewidth 4 pointtype 5 pointsize 0.5 title "Istio", \
    keyentry with linespoints linestyle 2 linewidth 4 pointtype 5 pointsize 0.5 title "Mazu", \
    keyentry title " ", \
    keyentry with linespoints linecolor rgb "black" linewidth 4 pointtype 5 pointsize 0.5 dashtype 1 title "avg", \
    keyentry with linespoints linecolor rgb "black" linewidth 4 pointtype 7 pointsize 0.5 dashtype 2 title "max", \
    'istio/pods_active.dat'      using 1:2 notitle with linespoints linestyle 1 linewidth 4 pointtype 5 pointsize 0.5 dashtype 1, \
    'istio/pods_active.dat'      using 1:3 notitle with linespoints linestyle 1 linewidth 4 pointtype 7 pointsize 0.5 dashtype 2, \
    'st5-AttUpd/pods_active.dat' using 1:2 notitle with linespoints linestyle 2 linewidth 4 pointtype 5 pointsize 0.5 dashtype 1, \
    'st5-AttUpd/pods_active.dat' using 1:3 notitle with linespoints linestyle 2 linewidth 4 pointtype 7 pointsize 0.5 dashtype 2
